{
  "name": "@mai/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "doctor": "pnpm dlx expo-doctor@latest",
    "check": "expo install --check",
    "dev": "expo start",
    "dev:ios": "expo start --ios",
    "dev:android": "expo start --android",
    "start": "expo start",
    "ios": "pnpm run dev:ios",
    "android": "pnpm run dev:android",
    "typecheck": "tsgo --noEmit",
    "format": "oxfmt",
    "lint": "NODE_OPTIONS='--experimental-strip-types' oxlint --quiet",
    "verify": "pnpm run format && pnpm run typecheck && pnpm run lint",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "run:ios": "expo run:ios",
    "run:android": "expo run:android",
    "build:android:local": "eas build --platform android --profile production --local --output ./prod.aab",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/atom-react": "4.1.1",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.16",
    "@mai/event-tracking": "workspace:^",
    "@mai/machines": "workspace:^",
    "@mai/nutrition": "workspace:^",
    "@mai/services": "workspace:^",
    "@mai/sqlite": "workspace:^",
    "@shopify/react-native-skia": "2.14.0",
    "@typeonce/effect-machine": "0.46.0",
    "@typeonce/effect-machine-react": "0.46.0",
    "effect": "4.1.1",
    "expo": "58.0.22",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.66.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "victory-native": "^42.0.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.1",
    "@react-native/metro-config": "0.88.1",
    "@types/react": "~19.3.0",
    "eas-cli": "^27.2.0",
    "tsx": "4.23.15",
    "vitest": "^5.0.5"
  }
}
