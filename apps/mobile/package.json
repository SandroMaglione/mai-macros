{
  "name": "@mai/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "doctor": "pnpm dlx expo-doctor@latest",
    "check": "expo install --check",
    "dev": "expo start",
    "dev:ios": "expo start --ios",
    "dev:android": "expo start --android",
    "start": "expo start",
    "ios": "pnpm run dev:ios",
    "android": "pnpm run dev:android",
    "typecheck": "tsgo --noEmit",
    "format": "oxfmt",
    "lint": "NODE_OPTIONS='--experimental-strip-types' oxlint --quiet",
    "verify": "pnpm run format && pnpm run typecheck && pnpm run lint",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "run:ios": "expo run:ios",
    "run:android": "expo run:android",
    "build:android:local": "eas build --platform android --profile production --local --output ./prod.aab",
    "machines:devtools": "effect-machine --include \"src/lib/*-machine.ts\"",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-rc.112",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.15",
    "@mai/event-tracking": "workspace:^",
    "@mai/machines": "workspace:^",
    "@mai/nutrition": "workspace:^",
    "@mai/services": "workspace:^",
    "@mai/sqlite": "workspace:^",
    "@shopify/react-native-skia": "2.6.2",
    "@typeonce/effect-machine": "0.33.0",
    "@typeonce/effect-machine-react": "0.33.0",
    "@xstate/react": "7.0.0-alpha.1",
    "effect": "4.0.0-rc.112",
    "expo": "57.0.20",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "lucide-react-native": "^1.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "use-sync-external-store": "1.6.0",
    "victory-native": "^41.26.0",
    "xstate": "6.0.0-alpha.18"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@typeonce/effect-machine-devtools": "0.33.0",
    "@types/react": "19.2.17",
    "@types/react-test-renderer": "19.1.0",
    "@types/use-sync-external-store": "1.5.0",
    "eas-cli": "^16.32.0",
    "react-test-renderer": "19.2.3",
    "tsx": "4.22.4"
  }
}
